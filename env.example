# Set only the variables for sections you want to enable

# YouTube Data API v3 — used for playlist videos and music video search. Get a key at https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_YOUTUBE_API_KEY=

# Behold.so — Instagram feed proxy. Get a feed ID at https://behold.so
NEXT_PUBLIC_BEHOLD_FEED_ID=

# Hardcover GraphQL API — used for book data. Get a token at https://hardcover.app/account/api
HARDCOVER_API_TOKEN=

# Hardcover user ID — your Hardcover user numeric ID
HARDCOVER_USER_ID=

# Last.fm API — used for recent scrobble. Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Last.fm username — your Last.fm username
NEXT_PUBLIC_LASTFM_USERNAME=

# Vercel API — used for top projects. Create a token at https://vercel.com/account/tokens
MY_VERCEL_API_TOKEN=

# Vercel team ID (optional) — team scope for project fetching
MY_VERCEL_TEAM_ID=

# Base URL for server-side fetches (defaults to http://localhost:3000)
NEXT_PUBLIC_BASE_URL=
